---
import Button from "../Button.astro";
import SectionHeading from "../SectionHeading.astro";
import { site } from "../../data/site";
import mapPin from "lucide-static/icons/map-pin.svg?raw";
import clock from "lucide-static/icons/clock.svg?raw";
import phoneIcon from "lucide-static/icons/phone.svg?raw";
import mailIcon from "lucide-static/icons/mail.svg?raw";

const items = [
  { icon: mapPin, label: "Endereço", value: `${site.endereco.linha1}, ${site.endereco.linha2}, ${site.endereco.cidade}` },
  { icon: clock, label: "Horários", value: site.horarios.map((h) => `${h.dias}: ${h.horas}`).join(" · ") },
  { icon: phoneIcon, label: "Telefone / WhatsApp", value: `${site.telefone} · ${site.whatsappNumero}` },
  { icon: mailIcon, label: "E-mail", value: site.email },
];
---

<section id="contato" class="scroll-mt-24 bg-charcoal px-6 py-28 lg:px-10 lg:py-36">
  <div class="mx-auto max-w-7xl">
    <SectionHeading
      eyebrow="Contato"
      title="Vamos cuidar do seu sorriso."
      description="Marque uma avaliação e conheça a estrutura da clínica de perto — o primeiro passo é só chamar no WhatsApp."
      tone="light"
    />

    <div class="mt-16 grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div data-reveal>
        <div class="grid gap-8 sm:grid-cols-2">
          {items.map((item) => (
            <div class="contact-item flex items-start gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-cream/15 text-gold-light" set:html={item.icon} />
              <div>
                <p class="text-[0.65rem] uppercase tracking-[0.2em] text-cream/45">{item.label}</p>
                <p class="mt-1.5 text-sm font-light leading-relaxed text-cream/85">{item.value}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-12 flex flex-wrap items-center gap-6">
          <Button href={site.whatsapp} target="_blank" tone="light" variant="solid">Chamar no WhatsApp</Button>
          <div class="flex items-center gap-3">
            <a href={site.redes.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex h-10 w-10 items-center justify-center rounded-full border border-cream/20 text-cream/80 transition-colors hover:border-gold hover:text-gold-light">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
            </a>
            <a href={site.redes.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex h-10 w-10 items-center justify-center rounded-full border border-cream/20 text-cream/80 transition-colors hover:border-gold hover:text-gold-light">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="min-h-[360px] overflow-hidden rounded-2xl" data-reveal data-reveal-delay="150">
        <iframe
          src={site.mapaEmbedSrc}
          class="h-full min-h-[360px] w-full grayscale-[35%] contrast-[1.05]"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Localização da Clínica Castello Branco"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-item :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
