---
import { getCollection } from "astro:content";
import SectionHeading from "../SectionHeading.astro";
import BlogCard from "../BlogCard.astro";
import Button from "../Button.astro";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
  .slice(0, 3);
---

<section class="bg-cream px-6 py-28 lg:px-10 lg:py-36">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
      <SectionHeading eyebrow="Blog" title="Notícias e cuidados." class="max-w-xl" />
      <div class="shrink-0" data-reveal>
        <Button href="/blog" tone="dark" variant="outline">Ver todas as notícias</Button>
      </div>
    </div>

    <div class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-12">
      {posts.map((post, i) => (
        <BlogCard
          slug={post.id}
          titulo={post.data.titulo}
          resumo={post.data.resumo}
          capa={post.data.capa}
          data={post.data.data}
          index={i}
        />
      ))}
    </div>
  </div>
</section>
