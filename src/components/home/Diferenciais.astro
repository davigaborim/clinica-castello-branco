---
import { diferenciais } from "../../data/site";
import heartHandshake from "lucide-static/icons/heart-handshake.svg?raw";
import sparkles from "lucide-static/icons/sparkles.svg?raw";
import sofa from "lucide-static/icons/sofa.svg?raw";
import calendarCheck from "lucide-static/icons/calendar-check.svg?raw";

const iconMap: Record<string, string> = {
  "heart-handshake": heartHandshake,
  sparkles,
  sofa,
  "calendar-check": calendarCheck,
};
---

<section class="bg-cream-dim px-6 py-24 lg:px-10 lg:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
      {diferenciais.map((item, i) => (
        <div
          class="diferencial-icon flex flex-col items-start border-t border-charcoal/10 pt-8"
          data-reveal
          data-reveal-delay={i * 100}
        >
          <span class="mb-6 flex h-11 w-11 items-center justify-center rounded-full bg-charcoal text-gold-light" set:html={iconMap[item.icone]} />
          <h3 class="font-display text-xl text-charcoal">{item.titulo}</h3>
          <p class="mt-3 text-sm font-light leading-relaxed text-lead-soft">{item.descricao}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .diferencial-icon :global(svg) {
    width: 18px;
    height: 18px;
  }
</style>
