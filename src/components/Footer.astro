---
import { withBase } from "../lib/url";

const whatsapp = "https://wa.me/5567984673592";
const year = new Date().getFullYear();

const columns = [
  {
    title: "Departamentos",
    links: [
      { label: "Início", href: "/" },
      { label: "Odontologia", href: "/odontologia" },
      { label: "Obstetra", href: "/parto" },
      { label: "Blog", href: "/blog" },
    ],
  },
  {
    title: "Institucional",
    links: [
      { label: "Equipe", href: "/equipe" },
      { label: "Especialidades", href: "/especialidades" },
      { label: "Convênios", href: "/convenios" },
    ],
  },
  {
    title: "Contato",
    links: [
      { label: "(67) 3023-3592", href: "tel:+556730233592" },
      { label: "WhatsApp (67) 98467-3592", href: whatsapp },
      { label: "contato@drajanainacastello.com.br", href: "mailto:contato@drajanainacastello.com.br" },
    ],
  },
];
---

<footer class="bg-charcoal px-6 pt-20 pb-10 text-cream lg:px-10">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-14 border-b border-cream/10 pb-14 sm:grid-cols-2 lg:grid-cols-[1.3fr_0.8fr_0.8fr_0.9fr_0.9fr]">
      <div class="sm:col-span-2 lg:col-span-1">
        <a href={withBase("/")}>
          <img src={withBase("/images/logo-lockup-light.png")} alt="Clínica Castello Branco" class="h-11 w-auto" />
        </a>
        <p class="mt-6 max-w-xs text-sm font-light leading-relaxed text-cream/60">
          Centro médico e odontológico em Campo Grande — cuidado humanizado, tecnologia de ponta e um ambiente
          pensado para acolher.
        </p>
        <div class="mt-7 flex items-center gap-4">
          <a href="https://www.instagram.com/janainacastellobranco" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex h-9 w-9 items-center justify-center rounded-full border border-cream/20 transition-colors hover:border-gold hover:text-gold-light">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
          </a>
          <a href="https://www.facebook.com/janainacastellobranco" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex h-9 w-9 items-center justify-center rounded-full border border-cream/20 transition-colors hover:border-gold hover:text-gold-light">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        </div>
      </div>

      {columns.map((col) => (
        <div>
          <h3 class="text-[0.7rem] uppercase tracking-[0.2em] text-gold">{col.title}</h3>
          <ul class="mt-6 space-y-3">
            {col.links.map((link) => (
              <li>
                <a href={link.href.startsWith("/") ? withBase(link.href) : link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined} class="text-sm font-light text-cream/70 transition-colors hover:text-cream">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <h3 class="text-[0.7rem] uppercase tracking-[0.2em] text-gold">Endereço</h3>
        <p class="mt-6 text-sm font-light leading-relaxed text-cream/70">
          Avenida Noroeste, 1070<br />
          Bairro Cabreúva<br />
          Campo Grande - MS
        </p>
        <p class="mt-5 text-sm font-light leading-relaxed text-cream/70">
          Seg a Sex · 08h–18h<br />
          Sábado · 08h–17h
        </p>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 pt-8 text-xs font-light text-cream/40 lg:flex-row">
      <p>© {year} Clínica Castello Branco — Centro Médico e Odontológico. Todos os direitos reservados.</p>
      <p>Campo Grande, MS</p>
    </div>
  </div>
</footer>
