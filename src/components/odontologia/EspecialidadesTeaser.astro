---
import SectionHeading from "../SectionHeading.astro";
import Button from "../Button.astro";
import { especialidades } from "../../data/site";
---

<section class="bg-cream-dim px-6 py-24 lg:px-10 lg:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
      <SectionHeading eyebrow="O que tratamos" title="Especialidades." class="max-w-xl" />
      <div class="shrink-0" data-reveal>
        <Button href="/especialidades" tone="dark" variant="outline">Ver todas</Button>
      </div>
    </div>

    <div class="mt-14 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {especialidades.slice(0, 4).map((esp, i) => (
        <div class="border-t border-charcoal/10 pt-6" data-reveal data-reveal-delay={i * 80}>
          <span class="font-display text-2xl text-gold-dim">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="font-display mt-4 text-xl text-charcoal">{esp.titulo}</h3>
          <p class="mt-2 text-sm font-light leading-relaxed text-lead-soft">{esp.descricao}</p>
        </div>
      ))}
    </div>
  </div>
</section>
